background: #
  padding: 28px 7%;
}

.header-inner {
  max-width: 1200px;
  margin: auto;
}

.logo {
  font-size: 25px;
  font-weight: 800;
}

.logo span {
  opacity: .65;
}

header p {
  margin: 8px 0 0;
  color: #cbd3df;
}

.container {
  max-width: 1200px;
  margin: 35px auto;
  padding: 0 22px;
}

.hero {
  margin-bottom: 25px;
}

.hero h1 {
  font-size: 38px;
  margin-bottom: 8px;
}

.hero p {
  max-width: 750px;
  color: #687386;
  line-height: 1.6;
}

.card {
  background: white;
  border: 1px solid #e2e7ef;
  border-radius: 16px;
  padding: 25px;
  margin-bottom: 22px;
  box-shadow: 0 5px 20px rgba(20,35,60,.05);
}

label {
  display: block;
  font-weight: 700;
  margin-bottom: 10px;
}

textarea {
  width: 100%;
  min-height: 150px;
  padding: 16px;
  border: 1px solid #ccd4df;
  border-radius: 10px;
  font-size: 15px;
  resize: vertical;
  outline: none;
}
